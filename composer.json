{
    "name": "jovinull/ticketclock",
    "description": "Time-based automation engine for GLPI tickets: business-day deadlines, conversation-aware clocks, configurable conditions and actions.",
    "type": "glpi-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Jovino",
            "email": "felipejovinogamerplay@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/Jovinull/ticketclock",
    "support": {
        "issues": "https://github.com/Jovinull/ticketclock/issues",
        "source": "https://github.com/Jovinull/ticketclock"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Ticketclock\\": "src/",
            "GlpiPlugin\\Ticketclock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit-unit.xml",
        "test:all": "phpunit",
        "cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer check --config=.php-cs-fixer.php",
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config=.php-cs-fixer.php",
        "locales:extract": "php tools/extract-locales.php",
        "locales:compile": "php tools/compile-locales.php",
        "headers": "php tools/apply-headers.php",
        "headers:check": "php tools/apply-headers.php --check"
    }
}
