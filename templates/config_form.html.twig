{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="asset">
    <form name="ticketclock_config" method="post" action="{{ config('root_doc') }}/plugins/ticketclock/front/config.form.php">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

        <div class="card-body d-flex flex-wrap">
            <div class="col-12 flex-column">

                {% if warnings|length > 0 %}
                    <div class="alert alert-warning" role="alert">
                        <div class="fw-bold mb-1">
                            <i class="ti ti-alert-triangle me-1"></i>{{ __('Current state', 'ticketclock') }}
                        </div>
                        <ul class="mb-0">
                            {% for warning in warnings %}
                                <li>{{ warning }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <div class="row flex-row">
                    {{ fields.largeTitle(__('Safety', 'ticketclock'), 'ti ti-shield-check', true) }}

                    {{ fields.dropdownYesNo('execution_enabled', config.execution_enabled, __('Enable execution', 'ticketclock'), {
                        'helper': __('Master switch. While this is off, rules are evaluated and logged but no ticket is ever modified. It ships off so a fresh install cannot act on anything.', 'ticketclock')
                    }) }}

                    {{ fields.dropdownYesNo('dry_run_global', config.dry_run_global, __('Global dry run', 'ticketclock'), {
                        'helper': __('Keeps every rule simulated even when execution is enabled. Useful while tuning rules on a live instance.', 'ticketclock')
                    }) }}

                    {{ fields.dropdownField('User', 'system_users_id', config.system_users_id, __('Acting user', 'ticketclock'), {
                        'right': 'all',
                        'helper': __('Author of the followups and solutions TicketFlow creates. Leave empty to reuse GLPI\'s own "system_user".', 'ticketclock')
                    }) }}

                    {% if acting_user is not empty %}
                        {{ fields.readOnlyField('resolved_acting_user', acting_user, __('Resolved acting user', 'ticketclock')) }}
                    {% endif %}
                </div>

                <div class="row flex-row">
                    {{ fields.largeTitle(__('Throughput', 'ticketclock'), 'ti ti-gauge') }}

                    {{ fields.numberField('batch_size', config.batch_size, __('Batch size', 'ticketclock'), {
                        'min': 1,
                        'helper': __('How many candidate tickets are loaded per query. Higher is faster but uses more memory.', 'ticketclock')
                    }) }}

                    {{ fields.numberField('max_tickets_per_run', config.max_tickets_per_run, __('Maximum candidates per run', 'ticketclock'), {
                        'min': 1,
                        'helper': __('Hard ceiling for one cron run, so a backlog can never turn into a single very long execution.', 'ticketclock')
                    }) }}

                    {{ fields.dropdownField('Calendar', 'fallback_calendars_id', config.fallback_calendars_id, __('Fallback calendar', 'ticketclock'), {
                        'helper': __('Used by rules in "entity calendar" mode when the entity tree defines none. Without it, business delays fall back to plain elapsed time, which is recorded on every execution.', 'ticketclock')
                    }) }}
                </div>

                <div class="row flex-row">
                    {{ fields.largeTitle(__('Logs', 'ticketclock'), 'ti ti-history') }}

                    {{ fields.dropdownYesNo('log_dry_runs', config.log_dry_runs, __('Log simulations', 'ticketclock'), {
                        'helper': __('Simulated matches are written to the execution log. They never block a later real execution.', 'ticketclock')
                    }) }}

                    {{ fields.numberField('log_retention_days', config.log_retention_days, __('Log retention (days)', 'ticketclock'), {
                        'min': 0,
                        'helper': __('Executions older than this are deleted by the purge automatic action. 0 disables the purge.', 'ticketclock')
                    }) }}
                </div>

            </div>
        </div>

        <div class="card-body mx-n2 border-top d-flex flex-row-reverse">
            <button class="btn btn-primary" type="submit" name="update" value="1">
                <i class="ti ti-device-floppy"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>
        </div>
    </form>
</div>
